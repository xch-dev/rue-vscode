{
  "scopeName": "source.rue",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#for-expressions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#punctuation" },
    { "include": "#strings" },
    { "include": "#types" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block-comments" },
        { "include": "#line-comments" }
      ]
    },
    "block-comments": {
      "patterns": [
        {
          "comment": "empty block comments",
          "name": "comment.block.rue",
          "match": "/\\*\\*/"
        },
        {
          "comment": "nested block comments",
          "name": "comment.block.rue",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#block-comments" }]
        }
      ]
    },
    "line-comments": {
      "comment": "line comments",
      "name": "comment.line.double-slash.rue",
      "match": "//.*$"
    },

    "constants": {
      "patterns": [
        {
          "comment": "constant variables",
          "name": "constant.other.caps.rust",
          "match": "\\b[A-Z]{2}[A-Z0-9_]*\\b"
        },
        {
          "comment": "constant items",
          "match": "\\b(const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.rue" },
            "2": { "name": "constant.rue" }
          }
        },
        {
          "comment": "integers",
          "name": "constant.numeric.decimal.rue",
          "match": "\\b(?:0x[0-9a-fA-F_]*|0o[0-7_]*|0b[01_]*|[0-9][0-9_]*)\\b"
        },
        {
          "comment": "booleans",
          "name": "constant.language.bool.rue",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "nil",
          "name": "constant.language.null.rue",
          "match": "\\b(nil)\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "function definition",
          "name": "meta.function.definition.rue",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.other.fn.rue" },
            "2": { "name": "entity.name.function.rue" }
          },
          "end": "\\{",
          "endCaptures": {
            "0": { "name": "punctuation.brackets.curly.rue" }
          },
          "patterns": [{ "include": "$self" }]
        },
        {
          "comment": "function call",
          "name": "meta.function.call.rue",
          "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:\\(|::<)",
          "beginCaptures": {
            "1": { "name": "entity.name.function.rue" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.brackets.round.rue" }
          },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },

    "for-expressions": {
      "comment": "for expression header, from `for` to the `{` of its body. `in` and `fold` are only keywords here",
      "begin": "\\b(for)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.rue" }
      },
      "end": "\\{",
      "endCaptures": {
        "0": { "name": "punctuation.brackets.curly.rue" }
      },
      "patterns": [
        {
          "comment": "contextual keywords in a for header",
          "name": "keyword.control.rue",
          "match": "\\b(in|fold)\\b"
        },
        {
          "comment": "struct binding after `for`, `,` or `fold`, which isn't the body",
          "begin": "(?<=\\bfor|,|\\bfold)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "punctuation.brackets.curly.rue" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.brackets.curly.rue" }
          },
          "patterns": [{ "include": "$self" }]
        },
        { "include": "#for-header-groups" },
        { "include": "$self" }
      ]
    },
    "for-header-groups": {
      "patterns": [
        {
          "comment": "parentheses in a for header, which can hold a `{`",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.brackets.round.rue" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.brackets.round.rue" }
          },
          "patterns": [{ "include": "#for-header-group-contents" }]
        },
        {
          "comment": "square brackets in a for header, which can hold a `{`",
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.brackets.square.rue" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.brackets.square.rue" }
          },
          "patterns": [{ "include": "#for-header-group-contents" }]
        }
      ]
    },
    "for-header-group-contents": {
      "patterns": [
        { "include": "#for-header-groups" },
        { "include": "$self" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "control flow keywords",
          "name": "keyword.control.rue",
          "match": "\\b(if|else|for|match|return|assert|raise|debug|super|project)\\b"
        },
        {
          "comment": "storage keywords",
          "name": "keyword.other.rue storage.type.rue",
          "match": "\\b(let|const)\\b"
        },
        {
          "comment": "modifier keywords",
          "name": "storage.modifier.rue",
          "match": "\\b(inline|export|extern|test)\\b"
        },
        {
          "comment": "type keyword",
          "name": "keyword.declaration.type.rue storage.type.rue",
          "match": "\\b(type)\\b"
        },
        {
          "comment": "struct keyword",
          "name": "keyword.declaration.struct.rue storage.type.rue",
          "match": "\\b(struct)\\b(?!\\s+_?[A-Z])"
        },
        {
          "comment": "enum keyword",
          "name": "keyword.declaration.enum.rue storage.type.rue",
          "match": "\\b(enum)\\b(?!\\s+_?[A-Z])"
        },
        {
          "comment": "fn keyword",
          "name": "keyword.other.fn.rue",
          "match": "\\b(fn)\\b"
        },
        {
          "comment": "mod keyword",
          "name": "keyword.other.mod.rue",
          "match": "\\b(mod)\\b"
        },
        {
          "comment": "other keywords",
          "name": "keyword.other.rue",
          "match": "\\b(as|is|import|from)\\b"
        },
        {
          "comment": "assignment operator",
          "name": "keyword.operator.assignment.equal.rue",
          "match": "(?<![<>])=(?!=|>)"
        },
        {
          "comment": "comparison operators",
          "name": "keyword.operator.comparison.rue",
          "match": "(==|!=|<=|(?<!=)>=)"
        },
        {
          "comment": "less than, greater than",
          "match": "(?:\\b|(?:(\\))|(\\])|(\\})))[ \\t]+([<>])[ \\t]+(?:\\b|(?:(\\()|(\\[)|(\\{)))",
          "captures": {
            "1": {
              "name": "punctuation.brackets.round.rue"
            },
            "2": {
              "name": "punctuation.brackets.square.rue"
            },
            "3": {
              "name": "punctuation.brackets.curly.rue"
            },
            "4": {
              "name": "keyword.operator.comparison.rue"
            },
            "5": {
              "name": "punctuation.brackets.round.rue"
            },
            "6": {
              "name": "punctuation.brackets.square.rue"
            },
            "7": {
              "name": "punctuation.brackets.curly.rue"
            }
          }
        },
        {
          "comment": "math operators",
          "name": "keyword.operator.math.rue",
          "match": "([+%*]|(-(?!>))|(/(?!/)))"
        },
        {
          "comment": "comparison operators",
          "name": "keyword.operator.comparison.rue",
          "match": "(&&|\\|\\|)"
        },
        {
          "comment": "bitwise operators",
          "name": "keyword.operator.bitwise.rue",
          "match": "(&|\\||\\^|<<|>>>?)"
        },
        {
          "comment": "ellipsis",
          "name": "keyword.operator.ellipsis.rue",
          "match": "\\.\\.\\."
        },
        {
          "comment": "range, as in a slice such as `list[1..]`",
          "name": "keyword.operator.range.rue",
          "match": "\\.\\.(?!\\.)"
        },
        {
          "comment": "dot access",
          "name": "keyword.operator.access.dot.rue",
          "match": "\\.(?!\\.)"
        },
        {
          "comment": "arrow",
          "name": "keyword.operator.arrow.skinny.rue",
          "match": "->"
        },
        {
          "comment": "fat arrow",
          "name": "keyword.operator.arrow.fat.rue",
          "match": "=>"
        }
      ]
    },
    "attributes": {
      "comment": "outer attributes such as `#[allow(unused_binding)]`, and inner attributes such as `#![allow(unused_binding)]`. One without its `]` ends before anything that can't be in an attribute, such as the item after it",
      "name": "meta.attribute.rue",
      "begin": "(#)(!?)(\\[)\\s*([a-zA-Z_][a-zA-Z0-9_]*)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.rue" },
        "2": { "name": "punctuation.definition.attribute.inner.rue" },
        "3": { "name": "punctuation.brackets.attribute.rue" },
        "4": { "name": "entity.name.function.attribute.rue" }
      },
      "end": "\\]|(?=[^\\s\\w(),/]|\\b(?:import|export|extern|inline|test|mod|fn|const|type|struct|enum|let|if|for|match|return|assert|raise|debug)\\b)",
      "endCaptures": {
        "0": { "name": "punctuation.brackets.attribute.rue" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#punctuation" },
        {
          "comment": "attribute arguments, such as lint names",
          "name": "variable.other.rue",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "colon",
          "name": "punctuation.separator.key-value.rue",
          "match": ":"
        },
        {
          "comment": "comma",
          "name": "punctuation.comma.rue",
          "match": ","
        },
        {
          "comment": "curly brackets",
          "name": "punctuation.brackets.curly.rue",
          "match": "[{}]"
        },
        {
          "comment": "parentheses",
          "name": "punctuation.brackets.round.rue",
          "match": "[()]"
        },
        {
          "comment": "semicolon",
          "name": "punctuation.semi.rue",
          "match": ";"
        },
        {
          "comment": "square brackets",
          "name": "punctuation.brackets.square.rue",
          "match": "[\\[\\]]"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "comment": "double quoted string",
          "name": "string.quoted.double.rue",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "comment": "single quoted string",
          "name": "string.quoted.single.rue",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "comment": "escape sequences, the same as Rust's, including a backslash at the end of a line",
          "name": "constant.character.escape.rue",
          "match": "\\\\(?:[nrt\\\\0'\"]|x[0-7][0-9a-fA-F]|u\\{[0-9a-fA-F](?:_*[0-9a-fA-F]){0,5}_*\\}|$)"
        },
        {
          "comment": "any other escape is invalid, but still never ends the string",
          "name": "invalid.illegal.escape.rue",
          "match": "\\\\."
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "primitive types",
          "name": "entity.name.type.primitive.rue",
          "match": "\\b(Atom|Bytes|Bytes32|String|PublicKey|Signature|K1PublicKey|K1Signature|R1PublicKey|R1Signature|Int|Bool|Any|Never|List|AlternatingList)\\b"
        },
        {
          "comment": "struct type",
          "match": "\\b(struct)\\s+(_?[A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.struct.rue storage.type.rue" },
            "2": { "name": "entity.name.type.struct.rue" }
          }
        },
        {
          "comment": "enum type",
          "match": "\\b(enum)\\s+(_?[A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.enum.rue storage.type.rue" },
            "2": { "name": "entity.name.type.enum.rue" }
          }
        },
        {
          "comment": "wildcard match arm",
          "name": "entity.name.type.rue",
          "match": "\\b_\\b(?=\\s*=>)"
        },
        {
          "comment": "named types",
          "name": "entity.name.type.rue",
          "match": "\\b_?[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "name": "variable.other.rue",
      "match": "\\b(?!(?:for|enum|match|super|project)\\b)[a-z_][a-zA-Z0-9_]*\\b(?!\\(|::<)"
    }
  }
}
